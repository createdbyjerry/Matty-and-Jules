{
  "$note": "Source of truth for design tokens. Edit this file, then run `npm run tokens` to regenerate assets/css/tokens.css. Each token becomes a CSS custom property named --<group>-<key> (color.ink -> --color-ink). Use {group.key} inside a $value to reference another token.",

  "color": {
    "bg":          { "$type": "color", "$value": "#E8DFCB", "$description": "Warm parchment page background" },
    "bg-grain":    { "$type": "color", "$value": "#DED3B8", "$description": "Diagonal grain stripe over the background" },
    "panel":       { "$type": "color", "$value": "#FBF6EA", "$description": "Cards and the dialogue box" },
    "panel-edge":  { "$type": "color", "$value": "#C8BA9A", "$description": "Hairline border on panels" },
    "ink":         { "$type": "color", "$value": "#2E2620", "$description": "Primary text and line art" },
    "ink-soft":    { "$type": "color", "$value": "#6B5F51", "$description": "Secondary text" },
    "accent":      { "$type": "color", "$value": "#B0592B", "$description": "Burnt clay, primary buttons" },
    "accent-dark": { "$type": "color", "$value": "#8C4420", "$description": "Button hover and pressed shadow" },
    "accent-tint": { "$type": "color", "$value": "#EFD9B8", "$description": "Secondary button hover" },
    "on-accent":   { "$type": "color", "$value": "{color.panel}", "$description": "Text on accent buttons" },
    "line":        { "$type": "color", "$value": "#C9BBA0", "$description": "Dividers" },
    "tag-ink":     { "$type": "color", "$value": "{color.ink}", "$description": "Name tag text and border, matches the line art" },
    "character": {
      "matty":     { "$type": "color", "$value": "#FCF6DA", "$description": "Matty's skin fill (warm cream), used for his name tag" },
      "jules":     { "$type": "color", "$value": "#F7FFF2", "$description": "Jules's skin fill (pale mint), used for her name tag" }
    }
  },

  "font": {
    "display": { "$type": "fontFamily", "$value": "'Fraunces', Georgia, serif", "$description": "Headings and name tags" },
    "body":    { "$type": "fontFamily", "$value": "'Work Sans', system-ui, sans-serif", "$description": "Dialogue and UI text" },
    "mono":    { "$type": "fontFamily", "$value": "'JetBrains Mono', ui-monospace, monospace", "$description": "Small labels" }
  },

  "radius": {
    "cover":   { "$type": "dimension", "$value": "16px", "$description": "Title and end screen cards" },
    "panel":   { "$type": "dimension", "$value": "14px", "$description": "Dialogue box" },
    "control": { "$type": "dimension", "$value": "8px",  "$description": "Buttons and name tags" }
  },

  "layout": {
    "char-w":     { "$type": "dimension", "$value": "240px", "$description": "Portrait width" },
    "char-h":     { "$type": "dimension", "$value": "calc({layout.char-w} * 682 / 436)", "$description": "Portrait height, locked to one sprite cell's aspect ratio" },
    "char-inset": { "$type": "dimension", "$value": "28px", "$description": "Distance from the dialogue box edge to a portrait" },
    "overlap":    { "$type": "dimension", "$value": "80px", "$description": "How far portraits sit over the dialogue box" },
    "name-inset": { "$type": "dimension", "$value": "calc({layout.char-w} + {layout.char-inset} + 18px)", "$description": "Header padding that clears the portraits" }
  },

  "motion": {
    "reveal-duration": { "$type": "duration",    "$value": "600ms", "$description": "Speaker, name tag and line fade-in" },
    "reveal-delay":    { "$type": "duration",    "$value": "80ms",  "$description": "Pause before the reveal starts" },
    "reveal-ease":     { "$type": "cubicBezier", "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$description": "Easing for the reveal" }
  },

  "$breakpoints": [
    {
      "name": "tablet",
      "media": "(max-width: 900px)",
      "$description": "Shrink portraits so both fit beside the name tag",
      "tokens": {
        "layout.char-w": "200px",
        "layout.char-inset": "16px"
      }
    },
    {
      "name": "mobile",
      "media": "(max-width: 640px)",
      "$description": "Portraits sit side by side above the box with no overlap",
      "tokens": {
        "layout.overlap": "0px",
        "layout.char-w": "min(40vw, 170px)",
        "layout.name-inset": "16px"
      }
    }
  ]
}
